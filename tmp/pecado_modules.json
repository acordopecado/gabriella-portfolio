  {
    "id": 1307254267,
    "oid": "_8-A3L_fkT7QifPFphfkIQ",
    "fullBleed": 0,
    "text": "<div><span style=\"color:#f9f9ea;\" class=\"texteditor-inline-color\"><span style=\"font-size:11px;\" class=\"texteditor-inline-fontsize\"><span style=\"font-size:12px;\" class=\"texteditor-inline-fontsize\">[PT] </span></span><span class=\"texteditor-inline-fontsize\" style=\"font-size:18px;\">Este trabalho foi apresentado como Trabalho de Conclusão de Curso (TCC) no curso de Jornalismo da <span class=\"bold\">ECA-USP</span> (Escola de Comunicações e Artes da Universidade de São Paulo), avaliado e aprovado pela banca examinadora em Julho de 2023.</span><br><br><span style=\"font-size:11px;\" class=\"texteditor-inline-fontsize\"><span style=\"font-size:12px;\" class=\"texteditor-inline-fontsize\">[EN] </span></span><span class=\"texteditor-inline-fontsize\" style=\"font-size:18px;\">This work was approved as the final thesis for the Bacharel Degree in Journalism in the University of São Paulo, in July, 2023.</span></span><br></div>",
    "alignment": "center",
    "__typename": "TextModule"
  }
]